        "query_id": "975",
        "sentence_id": "599bcc6b8e2463a849d4c296e1b1d52d",
        "sentence_text": "Initial studies conducted a decade ago highlighted the view that Crohn's disease inflammation is caused by an interleukin-12-driven Th1 response, which resulted in the generation of interferon-gamma, which then served as the main inflammatory mediator.",
        "sentence_token_cost": 50,
        "source_order": [
          525,
          0,
          3,
          0
        ],
        "source_position": 503
      },
      {
        "cross_encoder_score": -9.463300704956055,
